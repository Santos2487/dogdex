# Copy to .env and fill in. Same values the Next app reads as NEXT_PUBLIC_FIREBASE_*.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Base URL of the Next.js app (repo root) that serves POST /api/identify.
# Builds: the deployed Next site, e.g. https://<your-domain>
# Development: the Next dev server (`npm run dev` at the repo root, port 9002).
#   iOS simulator: http://127.0.0.1:9002
#   Android emulator: http://127.0.0.1:9002 plus `adb reverse tcp:9002 tcp:9002`
#   Physical device: http://<your-machine-LAN-IP>:9002
# If unset in development, the app uses the Metro host with port 9002.
EXPO_PUBLIC_API_URL=

# --- Local emulator mode ---
# EXPO_PUBLIC_USE_FIREBASE_EMULATORS=1
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# The Gemini key, GEMINI_MOCK and FIREBASE_AUTH_EMULATOR_HOST belong to the Next app's env,
# not here: see docs/expo-migration-plan.md.
