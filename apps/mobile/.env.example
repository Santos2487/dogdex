# Copy to .env and fill in. Same values the Next app reads as NEXT_PUBLIC_FIREBASE_*.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: base URL of the deployed API routes, used by native builds.
# In development, native falls back to the Metro host; web uses same-origin.
EXPO_PUBLIC_API_URL=

# --- Server only (API routes). NEVER prefix these with EXPO_PUBLIC_. ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Firebase project the API route accepts ID tokens for (defaults to EXPO_PUBLIC_FIREBASE_PROJECT_ID).
# FIREBASE_PROJECT_ID=

# --- Local emulator mode (see README) ---
# EXPO_PUBLIC_USE_FIREBASE_EMULATORS=1
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# GEMINI_MOCK=1
